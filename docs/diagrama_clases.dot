digraph UML_SistemaRuralPE {
    rankdir=TB;
    graph [fontname="Helvetica", label="Diagrama de Clases - SistemaRural PE", labelloc=t, fontsize=20, bgcolor="white", splines=ortho];
    node  [fontname="Helvetica", fontsize=11, shape=plaintext];
    edge  [fontname="Helvetica", fontsize=10];

    Persona [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="lightblue">
            <TR><TD><B>Persona</B></TD></TR>
            <TR><TD ALIGN="LEFT">- nombre: String<BR ALIGN="LEFT"/>- edad: int</TD></TR>
            <TR><TD ALIGN="LEFT">+ descripcion(): String</TD></TR>
        </TABLE>
    >];

    Paciente [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="lightgreen">
            <TR><TD><B>Paciente</B></TD></TR>
            <TR><TD ALIGN="LEFT">- huella_dni: str<BR ALIGN="LEFT"/>- dni_enmascarado: str<BR ALIGN="LEFT"/>- centro_poblado: str<BR ALIGN="LEFT"/>- historial: HistorialClinico</TD></TR>
            <TR><TD ALIGN="LEFT">+ restaurar(): Paciente</TD></TR>
        </TABLE>
    >];

    PersonalSalud [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="lightgreen">
            <TR><TD><B>PersonalSalud</B></TD></TR>
            <TR><TD ALIGN="LEFT">- cargo: str</TD></TR>
            <TR><TD ALIGN="LEFT">+ descripcion(): String</TD></TR>
        </TABLE>
    >];

    HistorialClinico [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="lightyellow">
            <TR><TD><B>HistorialClinico</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ agregarAtencion()<BR ALIGN="LEFT"/>+ obtenerAtenciones(): list</TD></TR>
        </TABLE>
    >];

    Cita [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="pink">
            <TR><TD><B>Cita</B></TD></TR>
            <TR><TD ALIGN="LEFT">- paciente: Paciente<BR ALIGN="LEFT"/>- fecha_hora: datetime<BR ALIGN="LEFT"/>- motivo: str</TD></TR>
        </TABLE>
    >];

    AgendaCitas [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="pink">
            <TR><TD><B>AgendaCitas</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ programar()<BR ALIGN="LEFT"/>+ cancelar()<BR ALIGN="LEFT"/>+ listar()</TD></TR>
        </TABLE>
    >];

    Atencion [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="orange">
            <TR><TD><B>Atencion</B></TD></TR>
            <TR><TD ALIGN="LEFT">- paciente: Paciente<BR ALIGN="LEFT"/>- tipo: str<BR ALIGN="LEFT"/>- fecha: date<BR ALIGN="LEFT"/>- campana: str<BR ALIGN="LEFT"/>- personal: PersonalSalud</TD></TR>
        </TABLE>
    >];

    AtencionEnPuesto [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="orange">
            <TR><TD><B>AtencionEnPuesto</B></TD></TR>
        </TABLE>
    >];

    AtencionBrigada [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="orange">
            <TR><TD><B>AtencionBrigada</B></TD></TR>
            <TR><TD ALIGN="LEFT">- campana: str</TD></TR>
        </TABLE>
    >];

    ServicioClinico [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="plum">
            <TR><TD><B>ServicioClinico</B></TD></TR>
            <TR><TD ALIGN="LEFT">- repositorio: RepositorioClinico<BR ALIGN="LEFT"/>- bus: BusEventos</TD></TR>
            <TR><TD ALIGN="LEFT">+ registrarPaciente()<BR ALIGN="LEFT"/>+ agendarCita()<BR ALIGN="LEFT"/>+ registrarAtencion()</TD></TR>
        </TABLE>
    >];

    RepositorioClinico [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="plum">
            <TR><TD><B>RepositorioClinico</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ guardar()<BR ALIGN="LEFT"/>+ buscarPorHuella()<BR ALIGN="LEFT"/>+ listar()</TD></TR>
        </TABLE>
    >];

    BusEventos [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="plum">
            <TR><TD><B>BusEventos</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ publicar()<BR ALIGN="LEFT"/>+ suscribir()</TD></TR>
        </TABLE>
    >];

    RegistroAuditoria [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="plum">
            <TR><TD><B>RegistroAuditoria</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ registrarEvento()</TD></TR>
        </TABLE>
    >];

    FabricaAtenciones [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="wheat">
            <TR><TD><B>FabricaAtenciones</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ crear(tipo, paciente, fecha, ...): Atencion</TD></TR>
        </TABLE>
    >];

    SistemaRuralError [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="salmon">
            <TR><TD><B>SistemaRuralError</B></TD></TR>
        </TABLE>
    >];

    DatosInvalidosError [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="salmon"><TR><TD><B>DatosInvalidosError</B></TD></TR></TABLE>>];
    CitaDuplicadaError [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="salmon"><TR><TD><B>CitaDuplicadaError</B></TD></TR></TABLE>>];
    PacienteNoEncontradoError [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="salmon"><TR><TD><B>PacienteNoEncontradoError</B></TD></TR></TABLE>>];

    // Herencia
    Paciente -> Persona [arrowhead=empty, label="extends"];
    PersonalSalud -> Persona [arrowhead=empty];
    AtencionEnPuesto -> Atencion [arrowhead=empty];
    AtencionBrigada -> Atencion [arrowhead=empty];
    DatosInvalidosError -> SistemaRuralError [arrowhead=empty];
    CitaDuplicadaError -> SistemaRuralError [arrowhead=empty];
    PacienteNoEncontradoError -> SistemaRuralError [arrowhead=empty];

    // Composición / asociaciones
    Paciente -> HistorialClinico [arrowhead=diamond, taillabel="1", headlabel="1"];
    AgendaCitas -> Cita [arrowhead=diamond, taillabel="1", headlabel="0..*"];
    Cita -> Paciente [taillabel="*", headlabel="1"];
    Atencion -> Paciente [taillabel="*", headlabel="1"];
    Atencion -> PersonalSalud [taillabel="*", headlabel="0..1"];
    ServicioClinico -> RepositorioClinico [taillabel="1", headlabel="1"];
    ServicioClinico -> BusEventos [taillabel="1", headlabel="1"];
    FabricaAtenciones -> Atencion [style=dashed, label="crea"];
}
